os := import("os")
fmt := import("fmt")
text := import("text")
nami := import("nami")
json := import("json")

b := nami.sh1("curl", "-L", "https://api.github.com/repos/vultr/vultr-cli/releases/latest")
if is_error(b) {
    fmt.println(b)
    os.exit(1)
}
v := json.decode(b).tag_name
err := nami.write_file(nami.cache_dir + "/version", v)
if is_error(err) {
    fmt.println(err)
    os.exit(1)
}

got := false
if nami.os == "darwin" && nami.arch == "arm64" {
    got = true
    nami.cp("https://github.com/vultr/vultr-cli/releases/latest/download/vultr-cli_"+v+"_macOs_arm64.tar.gz", {
	      "vultr-cli": nami.cache_dir+"/vultr-cli"
    })
}
if nami.os == "linux" && nami.arch == "amd64" {
    got = true
    nami.cp("https://github.com/vultr/vultr-cli/releases/latest/download/vultr-cli_"+v+"_linux_amd64.tar.gz", {
	      "vultr-cli": nami.cache_dir+"/vultr-cli"
    })
}
if !got {
    fmt.println("vultr-cli does not support your OS or Arch now. PR welcome: https://github.com/txthinking/nami/blob/master/package")
    os.exit(1)
}
